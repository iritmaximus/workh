{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": ["dist", "playwright-report", "test-results", "e2e/.data"],
  "overrides": [
    {
      "files": ["e2e/**"],
      "rules": {
        "no-empty-pattern": "off"
      }
    }
  ],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css", "@testing-library/jest-dom/vitest"]
      }
    ]
  }
}
